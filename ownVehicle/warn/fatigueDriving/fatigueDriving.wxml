<view class="list">
   <view class="item" wx:for="{{fatigueDrivingList}}">
    <view class="iconView" style="border-color: #ff791a;">
      <image mode="widthFix" src="/common/images/fatigueDriving.png"></image>
    </view>
    <view class="contentView">
      <view class="plateNumber">{{item.plateNumber}}</view>
      <view class="driverUserName">{{item.driverUserName}}</view>
      <view class="content">{{item.content}}</view>
    </view>
   </view>
</view>