page{
  background: #f5f5f5;
}
.list{
  background-color: #fff;
  border-top: 1rpx solid #eee;
}
.list .item{
  display: flex;
  position: relative;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.list .item .iconView{
  display: flex;
  border:4rpx solid #d81e06;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  position: relative;
}
.list .item:last-child .iconView{
  border-color: #ff791a;
}
.list .item .iconView image{
  width: 70%;
}
.list .item .contentView{
  flex: 1;
  padding:0 90rpx 0 20rpx;
  display: flex;
  justify-content: center;
  flex-direction: column;
}
.list .item .contentView .title{
  font-size: 28rpx;
  color: #333;
}
.list .item .contentView .content{
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}
.list .item .contentView .arrow{
  position: absolute;
  right: 20rpx;
  top:50%;
  font-size: 30rpx;
  margin-top: -15rpx;
}

.list .item .tip{
  position: absolute;
  right: 80rpx;
  top:50%;
  margin-top: -20rpx;
  border-radius: 50%;
  background: #d81e06;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}