<view class="list">
  <view class="item" wx:for="{{offLineList}}" bind:tap="toDetail" data-item="{{item}}">
    <view class="iconView">
      <image mode="widthFix" src="/common/images/offLine.png"></image>
    </view>
    <view class="contentView">
      <view class="plateNumber">{{item.plateNumber}}</view>
      <view class="content">{{item.content}}</view>
    </view>
  </view>
</view>