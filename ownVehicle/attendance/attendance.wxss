page{
  background: #f5f5f5;
  height: 100%;
}

.table-wrapper {
  margin-top: 20rpx;
  background: #fff;
  border-left: 1rpx solid #eee;
  border-top: 1rpx solid #eee;
  height: calc(100% - 100rpx);
  display: flex;
  flex-direction: column;
}

.thead {
  background: #eef1f6;
  display: flex;
  position: sticky;
  top: 0;
  z-index: 10;
}

.thead .td {
  display: flex;
  align-items: center;
  justify-content: center;
}

.scorll{
  flex: 1;
  overflow: auto;
}

.tbody-wrapper {
  display: flex;
  flex-direction: column;
}

.tbody {
  display: flex;
}

.tbody .td {
  display: flex;
  align-items: center;
  justify-content: center;
}

.table-wrapper .td {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  padding: 16rpx 0;
  line-height: 32rpx;
  font-size: 24rpx;
}
