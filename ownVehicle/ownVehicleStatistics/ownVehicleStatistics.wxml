<!-- 创建容器-此区域用于展示图表 -->
<view class="container" style="height: 500rpx;margin: 0;padding-top: 30rpx;">
  <!-- 使用 ec-canvas 组件，此处的命名为引入组件路径前面的定义 key 键的名字 -->
  <!-- 需要设置 id canvas-id ec 三个属性 -->
  <!-- id canvas-id ec名称可以自己定义，符合命名规范即可 -->
  <ec-canvas wx:if="{{showChart}}" id="myChart" canvas-id="myChart" ec="{{ec}}"></ec-canvas>
</view>

<!-- 创建容器-此区域用于展示图表 -->
<view class="container">
  <view class="pieTitle">车辆总数：{{info.stateNums1[0] + info.stateNums1[1]}}</view>
  <view class="pieList">
    <view class="pieItem" wx:if="{{showChart}}">
      <ec-canvas id="myChartPie" canvas-id="myChartPie" ec="{{ecPie}}"></ec-canvas>
    </view>
    <view class="pieItem" wx:if="{{showChart}}">
      <ec-canvas id="myChartPie2" canvas-id="myChartPie2" ec="{{ecPie2}}"></ec-canvas>
    </view>
  </view>
</view>

<view class="dataList">
  <!-- <view class="item">
    <view class="text" bind:tap="toAttendance" data-tab="1">昨天出勤率：{{attendanceData.yesterdayData.attendanceRate}}%</view>
    <view class="text" bind:tap="toAttendance" data-tab="1" data-type="1">昨天已出勤：{{attendanceData.yesterdayData.attendanceCount}}</view>
    <view class="text" bind:tap="toAttendance" data-tab="1" data-type="0">昨天未出勤：{{attendanceData.yesterdayData.noAttendanceCount}}</view>
  </view>
  <view class="item">
    <view class="text" bind:tap="toAttendance" data-tab="2">今天出勤率：{{attendanceData.todayData.attendanceRate}}%</view>
    <view class="text" bind:tap="toAttendance" data-tab="2" data-type="1">今天已出勤：{{attendanceData.todayData.attendanceCount}}</view>
    <view class="text" bind:tap="toAttendance" data-tab="2" data-type="0">今天未出勤：{{attendanceData.todayData.noAttendanceCount}}</view>
  </view>
  <view class="item">
    <view class="text" bind:tap="toReturnTripe">回程未派单：{{vehicleScheduleCount}}</view>
  </view> -->
  <view class="dataView">
    <view class="item" bind:tap="toAttendance" data-tab="1">
      <view class="num">{{attendanceData.yesterdayData.attendanceRate}}%</view>
      <view class="name">昨天出勤率</view>
    </view>
    <view class="item" bind:tap="toAttendance" data-tab="1" data-type="1">
      <view class="num">{{attendanceData.yesterdayData.attendanceCount}}</view>
      <view class="name">昨天已出勤</view>
    </view>
    <view class="item" bind:tap="toAttendance" data-tab="1" data-type="0">
      <view class="num">{{attendanceData.yesterdayData.noAttendanceCount}}</view>
      <view class="name">昨天未出勤</view>
    </view>
  </view>
  <view class="dataView">
    <view class="item" bind:tap="toAttendance" data-tab="2">
      <view class="num">{{attendanceData.todayData.attendanceRate}}%</view>
      <view class="name">今天出勤率</view>
    </view>
    <view class="item" bind:tap="toAttendance" data-tab="2" data-type="1">
      <view class="num">{{attendanceData.todayData.attendanceCount}}</view>
      <view class="name">今天已出勤</view>
    </view>
    <view class="item" bind:tap="toAttendance" data-tab="2" data-type="0">
      <view class="num">{{attendanceData.todayData.noAttendanceCount}}</view>
      <view class="name">今天未出勤</view>
    </view>
  </view>
  <view class="dataView">
    <view class="item" bind:tap="toReturnTripe" style="flex:0.33;">
      <view class="num">{{vehicleScheduleCount}}</view>
      <view class="name">回程未派单</view>
    </view>
  </view>
</view>

<view class="expire">
  <view class="paramView">
    <picker mode="selector" range="{{expireDayTypeList}}" bindchange="expireDayTypeChange" range-key="codeName" value="{{expireDayTypeIndex}}">
      <view wx:if="{{expireDayTypeList.length !=0 &&expireDayTypeIndex!=null}}">
        {{expireDayTypeList[expireDayTypeIndex].codeName}}
      </view>
      <view style="color:#c8c9cc;" wx:else>请选择</view>
      <van-icon name="arrow-down" class="arrow-down" />
    </picker>
    <!-- <button size="mini" type="primary" bind:tap="doQuery">查询</button> -->
  </view>
  <view class="dataView">
    <view class="item" bind:tap="toExpire" data-tab="1">
      <view class="num">{{info.insuranceExpireNum}}</view>
      <view class="name">保险到期</view>
    </view>
    <view class="item" bind:tap="toExpire" data-tab="2">
      <view class="num">{{info.annualInspectionExpireNum}}</view>
      <view class="name">年检到期</view>
    </view>
    <view class="item" bind:tap="toExpire" data-tab="3">
      <view class="num">{{info.maintenanceExpireNum}}</view>
      <view class="name">保养到期</view>
    </view>
  </view>
</view>


<!-- 创建容器-此区域用于展示图表 -->
<view class="container mileageChart">
  <view class="paramView">
    <picker mode="selector" range="{{mileageTypeList}}" bindchange="mileageTypeChange" range-key="codeName" value="{{mileageTypeIndex}}">
      <view wx:if="{{mileageTypeList.length !=0 &&mileageTypeIndex!=null}}">
        {{mileageTypeList[mileageTypeIndex].codeName}}
      </view>
      <view style="color:#c8c9cc;" wx:else>请选择</view>
      <van-icon name="arrow-down" class="arrow-down" />
    </picker>
  </view>
  <view class="pieList">
    <view class="pieItem" wx:if="{{showChart3}}">
      <ec-canvas id="myChartPie3" canvas-id="myChartPie3" ec="{{ecPie3}}"></ec-canvas>
    </view>
  </view>
</view>
<view class="expire mileage">
  <view class="mileageTitle">里程统计</view>
  <view class="dataView">
    <view class="item">
      <view class="num">{{mileageTypeInfo.sumMileageSum}}</view>
      <view class="name">总行驶里程</view>
    </view>
    <view class="item">
      <view class="num">{{mileageTypeInfo.effectiveMileageSum}}</view>
      <view class="name">有效里程</view>
    </view>
    <view class="item">
      <view class="num">{{mileageTypeInfo.deadheadMileageSum}}</view>
      <view class="name">空驶里程</view>
    </view>
  </view>
</view>

<view class="payInfo" wx:if="{{ownVehicleOrderFeeList && ownVehicleOrderFeeList.length>0}}">
  <view class="item" wx:for="{{ownVehicleOrderFeeList}}">
    <view class="num">{{item.nums}}条</view>
    <view class="amount">{{item.totalFee}}元</view>
    <view class="state">{{item.payStateName}}</view>
  </view>
</view>

<view class="msgView">
  <view class="item">
    <view class="iconView" bind:tap="toMap">
      <image mode="widthFix" src="/common/images/position.png"></image>
    </view>
    <view class="name">实时定位</view>
  </view>
  <view class="item" bind:tap="toWarn">
    <view class="iconView">
      <image mode="widthFix" src="/common/images/alarm.png"></image>
      <view class="tip" wx:if="{{info.warningNum > 0}}">{{info.warningNum}}</view>
    </view>
    <view class="name">告警提示</view>
  </view>
</view>