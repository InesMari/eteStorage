page{
  background: #f1f2f5;
  padding-bottom: 130rpx;
}

.van-cell__title{
  max-width: 180rpx!important;
  flex:initial!important;
  -webkit-flex:initial!important;
}
.van-cell__value{
  text-align: right;
  color: #333!important;
}
van-radio{
  display: inline-block;
  margin-left: 20rpx;
}

.uploadImg{
  padding:20rpx 30rpx 0;
  margin-top: 20rpx;
  background: #fff;
}
.uploadImg .title{
  margin-bottom: 20rpx;
}
.uploadImg .item{
  float: left;
  width: 200rpx;
  height: 200rpx;
  border-radius: 6rpx;
  margin:0 20rpx 20rpx 0;
}
.uploadImg .item image{
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.footerBtn.btns button{
  margin-left:20rpx;
  font-size: 24rpx;
  padding:0 20rpx;
}
.mylink .van-cell__value{
  text-decoration: underline!important;
  color: #3894ff!important;
}
.mylink .van-cell__title{
  max-width: initial!important;
}
/* 完成页面 */
.finishPage van-icon{
  width: 100%;
}
.finishPage .van-icon{
  color: red;
  margin:120rpx auto 50rpx;
  font-size: 230rpx;
}
.finishPage .tipText{
  text-align: center;
  font-size: 32rpx;
  color: red;
}
.finishPage .numTip{
  text-align: center;
  margin-top: 40rpx;
  color: #999;
}
.finishPage .con{
  width: 80%;
  margin: 80rpx auto;
  border-top: 1rpx solid #ddd;
  padding: 10rpx;
}
.finishPage .con .item{    
  color: #999;
  line-height: 90rpx;
  font-size: 26rpx;
}
.finishView{
  position: fixed;
  bottom:90rpx;
  left: 10%;
  width: 80%;
  box-sizing: border-box;
}
.finishView button{
  background: red;
  line-height: 76rpx;
  height: 76rpx;
  width: 100%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
}
.finishView .backText{
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin-top: 60rpx;
}

.showUnPassAlert .content{
  padding: 40rpx 30rpx;
}
.showUnPassAlert .content input{
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border:1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}
.showUnPassAlert .bottom{
  border-top:1rpx solid #f6f6f6;
}
.showUnPassAlert .bottom button{
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}
.showUnPassAlert .bottom button:last-child{
  border:none;
}


.titleTab {
  padding: 20rpx 30rpx;
  background: #fff;
  font-size: 30rpx;
  margin-top: 20rpx;
}

/* 流程 */
.stepView{
  background: #fff;
  padding: 0 20rpx 0 80rpx;
  margin-bottom: 20rpx;
}
.stepView .item{
  line-height: 40rpx;
  font-size: 24rpx;
  position: relative;
  border-bottom: 1rpx dashed #f5f5f5;
  padding: 20rpx 0;
}
.stepView .item:last-child{
  border-bottom: none;
}
.stepView .item::after{
  content: "";
  position: absolute;
  top:26rpx;
  left: -36rpx;
  border-left: 1rpx dashed #1990ff;
  height: 100%;
}

.stepView .item.ispass::after{
  border-left: 1rpx solid #1990ff;
}
.stepView .item:last-child:after{
  display: none;
}
.stepView .icon{
  display: inline-block;
  height: 32rpx;
  font-size: 28rpx;
  background-color: #fff;
  position: relative;
  top: 26rpx;
  left: -50rpx;
  z-index: 99;
  position: absolute;
}
.stepView .date{
  color: #999;
}
