/* pages/findcar/findcar.wxss */
.searchform {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 30rpx 20rpx;
    background: #ffffff;
    border-bottom: 2rpx solid #bbbbbb;
}

.searchbox {
    width: 554rpx;
}

.searchbtn {
    position: relative;
    width: 550rpx;
    height: 60rpx;
    border: 2rpx solid #FF9800;
    border-radius: 12rpx;
    font-size: 24rpx;
    line-height: 52rpx;
    text-align: center;
    margin-bottom: 20rpx;
}

.searchbtn image {
    width: 44rpx;
    height: 44rpx;
    position: absolute;
    left: 28rpx;
    top: 10rpx;
}

.searchbtn input {
    padding: 10rpx 0;
}

.searchform button {
    display: block;
    width: 120rpx;
    height:64rpx;
    background: #ff9800;
    font-size: 24rpx;
    color: #ffffff;
    line-height: 64rpx;
    text-align: center;
    border-radius: 12rpx;
    margin-left: 20rpx;    
    position: absolute;
    right: 20rpx;
    top: 30rpx;
    z-index: 9;
}

.checkbox {
    width: 100%;
    font-size: 24rpx;
    line-height: 34rpx;
    margin-top:20rpx;
}
.checkbox text{
    color: blue;
}

/*checkbox 选项框大小  */
checkbox .wx-checkbox-input {
    width: 34rpx;
    height: 34rpx;
    border-color: #ff9800;
}

/*checkbox选中后样式  */
checkbox .wx-checkbox-input.wx-checkbox-input-checked {
    background: #ff9800;
}

/*checkbox选中后图标样式  */
checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
    width: 34rpx;
    height: 34rpx;
    line-height: 34rpx;
    text-align: center;
    font-size: 24rpx;
    color: #fff;
    background: transparent;
    transform: translate(-50%, -50%) scale(1);
    -webkit-transform: translate(-50%, -50%) scale(1);
}
.expected {
    padding: 30rpx;
    color: #101010;
    background: #fff;
    box-sizing: border-box;
    position: fixed;
    bottom:0;
    width: 100%;
    text-align: left;
    font-size: 28rpx;
    font-weight: 400;
    line-height: 48rpx;
}
.fl{
   width:300rpx;
   float:left;
}
.fr{
    width:360rpx;
    float:left;
    margin-left:30rpx;
}
.pop{
    width:680rpx;
    border:2rpx solid #bbbbbb;
    background:#ffffff;
    position: fixed;
    top:140rpx;
    left:33rpx;
    position:relative;
}
.pop .title{
    height:120rpx;
    line-height:120rpx;
    text-align:center;
    font-size:40rpx;
    color:#101010;
}
.pop .text{
    width:620rpx;
    padding:0 30rpx;
    line-height:48rpx;
    font-size:30rpx;
    color:#101010;
    white-space:normal;
    position:absolute;
    left:0;
    top :100rpx;
}
.btngroup{
    width:680rpx;
    border-top:2rpx solid #bbbbbb;
    overflow:hidden;
    margin-top:140rpx;
}
.calcel{
    display:block;
    float:left;
    width:338rpx;
    height:86rpx;
    line-height:86rpx;
    text-align:center;
    font-size:36rpx;
    letter-space:20rpx;
    color:#ff9304;
    border-right:2rpx solid #bbbbbb;
}
.confirm{
    display:block;
    float:left;
    width:680rpx;
    height:86rpx;
    line-height:86rpx;
    text-align:center;
    font-size:36rpx;
    letter-space:20rpx;
    color:#e23e43;
}