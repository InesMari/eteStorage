<form bindsubmit="doQuery">
    <view class="searchform">
        <view class="searchbox">
            <view class="searchbtn">    
                <image src="../common/images/u651.png"></image>
                <input class="searchinput" name="" value="{{licensePlate}}" placeholder="请输入指定车牌号" bindinput="bindKeyInput"></input>
            </view>
            <checkbox-group bindchange="checkboxChange">
                <label class="checkbox" wx:for="{{items}}">
                    <checkbox value="{{item.name}}" checked="{{item.checked}}"/>{{item.value}}
                </label>
            </checkbox-group>
        </view>
        <button form-type="submit">查询</button>
        <!-- <view class="checkbox">
            <checkbox color="#ff9800" value="" checked="checked"/>我已阅读并同意<text>《易迁易用户获取车辆信息协议》</text>
        </view> -->
    </view>
</form>
<map id="myMap" style="width: 100%; height:100vh;" scale='16' latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}"
        show-location>
    <cover-view class="expected" wx:if="{{showInfo}}">
        <!--		<cover-view>车牌号：{{licensePlate}}</cover-view>-->

    <cover-view>
        <cover-view class="fl">车牌号：{{licensePlate}}</cover-view>
        <cover-view class="fr">车辆平台：{{vehiclePlatform}}</cover-view>
        <cover-view class="fl">运作状态：{{isLockName}}</cover-view>
        <cover-view class="fr">车辆类型：{{vehicleType}}</cover-view>
        <cover-view class="fl">车主姓名：{{vehicleOwnname}}</cover-view>
        <cover-view class="fr">联系方式：{{vehicleBill}}</cover-view>
    </cover-view>

</cover-view>
<!-- 无法查询弹窗 -->
<cover-view class="pop" wx:if="{{showDialog}}">
    <cover-view class="title">无法查询</cover-view>
    <cover-view class="text">本次查询结果为空，请确定该用户是否为已上易迁易平台或者国家部标机。客服热线：020-32633382</cover-view>
    <cover-view class="btngroup">
<!-- <cover-view class="calcel">取消</cover-view> -->
			<cover-view class="confirm" bindtap="Calcel">确定</cover-view>
		</cover-view>
	</cover-view>
</map>
