page{
  background: #f5f5f5;
  height: 100%;
}
.scorll{
  height: calc(100% - 211rpx);
}
.list{
  padding: 24rpx 30rpx;
  border-radius: 4rpx;
}
.list .item{
  padding:28rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}
.item .info{
  line-height: 40rpx;
  position: relative;
}
.item .info>view{
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-bottom: 14rpx;
  display: flex;
}
.item .info .text{
  color: #666;
  color: #666;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}
.item .info .price{
  font-size: 34rpx;
  position: absolute;
  right: 0;
  top: 0;
  line-height: 1;
}