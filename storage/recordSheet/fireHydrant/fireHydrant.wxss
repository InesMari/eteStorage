page{
  height: 100%;
}
.inspectionDetailPage {
  box-sizing: border-box;
  height: 100%;
  overflow: auto;
}

.scanView {
  width: 60%;
  margin:30vh auto;
}

.codeView {
  display: flex;
  margin-bottom: 50rpx;
}

.codeView input {
  flex: 1;
  border: 1rpx solid #999;
  line-height: 90rpx;
  height: 90rpx;
  padding: 0 20rpx;
}

.codeView button {
  width: 150rpx;
}

.taskTitle{
  text-align: center;
  font-weight: bold;
  line-height: 100rpx;
  font-size: 26rpx;
}
.taskHead{
  border-top: 1rpx solid #e5e5e5;
  background-color: #f5f5f5;
  display: flex;
}
.taskHead .taskItem{
  height: 80rpx;
}
.taskBody{
  display: flex;
  align-items: center;
  justify-content: center;
}
.taskItem{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-right: 1rpx solid #e5e5e5;
  border-bottom: 1rpx solid #e5e5e5;
  height: 120rpx;
  padding:0 10rpx;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  word-break: break-all;
  flex-direction: column;
}

.zoom-container {
  box-sizing: border-box;
  padding-top: 40rpx;
}

.tableTitle {
  position: relative;
  padding-bottom: 20px;
}

.tableTitle image {
  position: absolute;
  height: 40px;
  left: 10px;
  top: 10px;
}

.title-h3 {
  font-weight: bold;
  font-size: 20px;
  line-height: 40px;
  text-align: center;
  color: #000;
}

.title-p {
  text-align: center;
  font-weight: bold;
}

.tableBox {
  overflow: auto;
}

/* 表格整体样式 */
.tableCommon {
  display: inline-flex;
  flex-direction: column;
  border-top: 1px solid #e5e5e5;
}

.tr {
  display: inline-flex;
}

.tr .th {
  background-color: #f5f5f5;
}

.th,
.td {
  border-right: 1px solid #e5e5e5;
  border-bottom: 1px solid #e5e5e5;
  padding: 8px 5px;
  text-align: center;
  box-sizing: border-box;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 36rpx;
  /* 不允许收缩 */
}
.td.left{
  justify-content: flex-start;
}
.td.flex>view{
  margin-right: 20rpx;
}

.th:last-child,
.td:last-child {
  border-right: none;
}

.lr {
  writing-mode: vertical-lr;
  text-orientation: upright;
}

.fl {
  float: left;
}

.fr {
  float: right;
}