.banner {
  padding: 0 30rpx 30rpx;
}

.banner image {
  width: 100%;
}

.startWord {
  padding: 0 30rpx 18rpx;
  line-height: 40rpx;
  font-size: 24rpx;
}

.putTable {
  margin: 18rpx 30rpx;
  border-left: 1rpx solid #eee;
  border-top: 1rpx solid #eee;
}

.putTable .item {
  width: 50%;
  display: flex;
  float: left;
}

.putTable .label {
  width: 150rpx;
  background: #f5f5f5;
  line-height: 60rpx;
  font-size: 24rpx;
  text-align: center;
}

.putTable .input-text {
  flex: 1;
  border-right: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  line-height: 60rpx;
  font-size: 24rpx;
  text-align: center;
}

.putTable .row {
  display: flex;
  height: 60rpx;
}

.putTable .row>view {
  flex: 1;
  font-size: 24rpx;
  border-right: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.myField {
  margin-bottom: 40rpx;
  margin-top: 10rpx;
}

.myField .item {
  display: block;
}

.myField .item .label {
  max-width: 100%;
  width: 100%;
  float: initial;
  margin-bottom: 14rpx;
}

.myField .item .input-text {
  padding: 0;
  margin-top: 6prx;
}

.questionList {
  padding: 18rpx 30rpx;
}

.submit {
  background: #E12006;
  line-height: 74rpx;
  height: 76rpx;
  width: 90%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
  margin: 40rpx auto;
}

.aboutme {
  padding: 18rpx 30rpx;
}

.aboutme view {
  color: #999;
  line-height: 40rpx;
  font-size: 24rpx;
}

.aboutme text {
  margin-left: 40rpx;
}

.company {
  font-size: 24rpx;
  line-height: 150rpx;
  color: #999;
  text-align: center;
}

.tips {
  padding: 10rpx 30rpx 30rpx;
  border-bottom: 1px solid #eee;
}

.tips .content view {
  line-height: 50rpx;
}

.tips .title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  font-weight: bold;
}


.endView{
  position: fixed;
  width: 100%;
  height: 100%;
  background: #fff;
  top: 0;
  left: 0;
  z-index: 999;
}
.endView .content{
  position: absolute;
  top: 30%;
  left: 0;
  width: 100%;
}
.endView image{
  width: 300rpx;
  margin:0 auto 50rpx;
}
.endView .content>view{
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
}
.endView .endViewCompany{
  position: absolute;
  bottom: 50rpx;
  left: 0;
  width: 100%;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
}