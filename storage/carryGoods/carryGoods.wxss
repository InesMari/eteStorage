page{
  background: #f5f5f5;
  height: 100%;
}
.van-tabs__nav{
  width: 100%;
}
.scorll{
  height: calc(100% - 120rpx);
}
.list{
  padding: 24rpx 30rpx;
  border-radius: 4rpx;
}
.list .item{
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}
.list .item .inner{
  padding:28rpx 24rpx 0;
  border-bottom: 1rpx solid #F6F6F6;
}
.item .title{
  margin-bottom: 32rpx;
  font-weight: bold;
}
.item .title .router{
  font-size: 32rpx;
  line-height: 40rpx;
  float: left;
}
.item .title .waitTime{
  float: right;
  margin: 0 30rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: red;
  font-weight: normal;
}
.item .title .state{
  float: right;
  line-height: 40rpx;
  font-size: 24rpx;
  min-width: 100rpx;
  padding:0 20rpx;
  height: 40rpx;
  background: #FFCDCD;
  border-radius: 50rpx;
  color: #E60012;
  text-align: center;
}
.item .title .state.state1{
  color: #0CCBF8;
  background: #E6F4F9;
}
.item .title .state.state2{
  color: #05D188;
  background: #E6F7F0;
}
.item .title .state.state3{
  color: #C5C5C5;
  background: #F1F2F5;
}
.item .title .state.state5{
  color: #FF7C1C;
  background: #FFDDCB;
}
.item .info{
  line-height: 40rpx;
  position: relative;
}
.item .info>view{
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-bottom: 14rpx;
  display: flex;
}
.item .info .text{
  color: #666;
  color: #666;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}
.item .info .price{
  font-size: 34rpx;
  position: absolute;
  right: 0;
  top: 0;
  line-height: 1;
}
.item .isUrgent{
  border-radius: 50rpx;
  height: 30rpx;
  width: 60rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #E12006;
  margin: 8rpx 16rpx 0;
}
.operate{
  padding:18rpx 24rpx;
}
.operate .time{
  line-height: 56rpx;
  font-size: 26rpx;
}
.operate .btn{
  background: #fff;
  line-height: 54rpx;
  height: 56rpx;
  border-radius: 50rpx;
  color: #E60012;
  font-size: 25rpx;
  box-sizing: border-box;
  margin-left: 20rpx;
  padding: 0 20rpx;
}
.operate .btn::after{
  border: 1rpx solid #E60012;
}

.showAlert .content{
  padding: 40rpx 30rpx;
  line-height: 60rpx;
  text-align: center;
}
.showAlert .content input{
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border:1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}
.showAlert .bottom{
  border-top:1rpx solid #f6f6f6;
}
.showAlert .bottom button{
  width: 50%;
  font-size: 26rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}
.showAlert .bottom button:last-child{
  border:none;
}


/* 组织弹窗 */
.organizationAlert .listView{
  max-height:800rpx;
  overflow-y:auto;
  padding-top:30rpx;
}
.organizationAlert .van-radio{
  padding: 20rpx 30rpx;
}
.organizationAlert .bottom{
  border-top:1rpx solid #eee;
}
.organizationAlert .bottom button{
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
}
.organizationAlert .bottom button:last-child{
  border:none;
}
.changeWork{
  position: absolute;
  bottom: 15%;
  right: 30rpx;
  padding: 18rpx;
  background-color: #05D188;
  opacity: 0.5;
  border-radius: 50%;
  overflow: hidden;
  z-index: 99;
}
.changeWork view{
  font-size: 22rpx;
  color: #fff;
  line-height: 1.1;
}

/* 修改到货厂商弹窗 */
.showChangeTenantAlert .content{
  padding: 40rpx 30rpx;
}
.showChangeTenantAlert .field{
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  min-height: 50rpx;
}
.showChangeTenantAlert .field .label{
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  width: 180rpx;
}
.showChangeTenantAlert .field .value{
  font-size: 28rpx;
  color: #666;
  flex: 1;
  word-break: break-all;
}
.showChangeTenantAlert .field .input-wrapper{
  flex: 1;
  position: relative;
}
.showChangeTenantAlert .input{
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  transition: all 0.3s ease;
}
.showChangeTenantAlert .input:focus{
  border-color: #3894ff;
  background: #fff;
}
.showChangeTenantAlert .input::placeholder{
  color: #ccc;
}
.showChangeTenantAlert .bottom{
  border-top: 1rpx solid #f0f0f0;
  display: flex;
}
.showChangeTenantAlert .bottom button{
  flex: 1;
  font-size: 28rpx;
  line-height: 88rpx;
  background: #fff;
  box-sizing: border-box;
  border: none;
  float: none;
}
.showChangeTenantAlert .bottom button:first-child{
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}
.showChangeTenantAlert .bottom button:last-child{
  color: #3894ff;
  font-weight: 500;
}
.showChangeTenantAlert .bottom button:active{
  background: #f5f5f5;
}