page {
  background: #f1f2f5;
}
.contentView{
  background: #f1f2f5;
  padding-bottom: 130rpx;
  padding-top: 110rpx;
}

van-tabs {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 999;
}

.titleTab {
  padding: 20rpx 30rpx;
  background: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.titleInner {
  padding: 15rpx 30rpx;
  background: #fff;
  font-size: 26rpx;
  position: relative;
  font-weight: bold;
}

.myCell .van-cell {
  border-bottom: 1rpx solid #efefef;
  padding: 16rpx 30rpx;
}

.myCell .van-cell__title {
  min-width: initial;
  max-width: initial;
  font-size: 24rpx;
  flex: initial;
}

.myCell .van-cell__value {
  color: #333;
  font-size: 24rpx;
  padding-left: 12rpx;
}

.breakCell .van-cell {
  display: block;
}

.breakCell .van-cell .van-cell {
  padding: 0 !important;
}

.breakCell .van-field__input {
  padding-left: 0 !important;
}

.breakCell .van-field__input--disabled {
  background: none !important;
}

.breakCell .van-cell__title {
  max-width: initial !important;
}

.breakCell .van-cell__value {
  text-align: left;
}

van-radio {
  display: inline-block;
  margin-right: 30rpx;
}

checkbox-group {
  margin: 20rpx 0;
}

.cheboxLabel {
  height: 50rpx;
  color: #333;
  margin-right: 100rpx;
}

.van-radio__label {
  margin-left: 10rpx;
}

.uploadImg {
  background-color: #fff;
  padding: 20rpx 32rpx;
}

.uploadImg .title {
  line-height: 50rpx;
}

.uploadImg .tip {
  font-size: 24rpx;
  margin: 10rpx 0 20rpx;
  color: #999;
}

.inspectContent {
  display: flex;
}

.areaView {
  float: left;
  border: 1rpx solid #eee;
  padding: 10rpx 20rpx;
  width: calc(100% - 220rpx);
  box-sizing: border-box;
}

.areaView.disabled {
  background: #eee;
}

.areaView textarea {
  padding: 15rpx 0;
  height: 150rpx;
  width: 100%;
}

.imgView {
  float: left;
  width: 200rpx;
  height: 200rpx;
  margin-left: 20rpx;
}



.van-uploader__preview-image,
.van-uploader__upload {
  width: 200rpx !important;
  height: 200rpx !important;
}

.van-uploader__preview {
  margin: 0 20rpx 20rpx 0 !important;
}

.footerBtn.btns {
  display: flex;
}

.footerBtn.btns button {
  margin-left: 20rpx;
  font-size: 24rpx;
  flex: 1;
  padding: 0 20rpx;
}

.myField .item:last-child::before {
  display: none;
}

.myField .item {
  display: block;
}

.myField .item .label {
  max-width: initial;
  float: initial;
  font-size: 24rpx;
}

.myField .item .input-text {
  font-size: 24rpx;
  border-bottom: 1rpx dashed #efefef;
  color: #999;
}

.myField .item .input-text:last-child {
  border: none;
}

.myField .item .input-text text {
  display: inline-block;
  width: 126rpx;
}

.topTitle {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #fff;
  z-index: 99;
  border-bottom: 1rpx solid #eee;
  font-weight: bolder;
}

.van-collapse-item__content {
  padding: 0!important;
}

.van-cell--clickable{
  justify-content: space-between!important;
}
.van-collapse-item__title .van-cell__title{
  font-weight: bold;
}

/* 巡检列表 */
.taskTitle{
  text-align: center;
  font-weight: bold;
  line-height: 100rpx;
  font-size: 26rpx;
}
.taskHead{
  border-top: 1rpx solid #e5e5e5;
  background-color: #f5f5f5;
  display: flex;
}
.taskHead .taskItem{
  height: 80rpx;
}
.taskBody{
  display: flex;
  align-items: center;
  justify-content: center;
}
.taskItem{
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-right: 1rpx solid #e5e5e5;
  border-bottom: 1rpx solid #e5e5e5;
  height: 120rpx;
  padding:0 10rpx;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  word-break: break-all;
  flex-direction: column;
}

.noTask{
  position: fixed;
  text-align: center;
  width: 100%;
  top: 30%;
  font-size: 32rpx;
  font-weight: bold;
}