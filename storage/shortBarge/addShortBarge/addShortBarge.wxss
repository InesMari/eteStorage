page {
  background: #F1F2F5;
  padding-bottom: 120rpx;
}

.pageTitle {
  margin: 30rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
}

.pageTitle .bg {
  height: 140rpx;
  width: 100%;
}

.pageTitle .info {
  position: absolute;
  height: 100%;
  width: 100%;
  top: 0;
  left: 0;
  padding: 28rpx;
  box-sizing: border-box;
}

.pageTitle .info .route>view {
  font-size: 32rpx;
  color: #fff;
  line-height: 1;
}

.pageTitle .info .waybillNum {
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
  margin-top: 22rpx;
}

.tabs {
  margin: 30rpx;
  border: 1rpx solid #1990ff;
  border-radius: 6rpx;
  background: #fff;
}

.tabs .tab {
  color: #1990ff;
  line-height: 70rpx;
  text-align: center;
  float: left;
  width: 33.3333%;
  border-right: 1rpx solid #1990ff;
  box-sizing: border-box;
}

.tabs .tab:last-child {
  border: none;
}

.tabs .tab.active {
  color: #fff;
  background: #1990ff;
}

.myField .item .input-text .van-radio{
  float: left;
  margin-right: 30rpx;
}

.filter-container {
  height: 100%;
}

.filter-container input {
  width: 90%;
  display: block;
  margin: 20rpx auto;
  border: 1rpx solid #dee2e9;
  border-radius: 6rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 80rpx;
}

.filter-container .scrollList {
  height: calc(100% - 280rpx);
}

.filter-container .scrollList .item {
  line-height: 40rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #dee2e9;
}

.filter-container .scrollList .item.active {
  color: #fff;
  background: #1990ff;
}

.filter-container .scrollList .item:first-child {
  border-top: 1rpx solid #dee2e9;
}

.filter-container .btn {
  margin: 30rpx 5% 30rpx 10%;
  width: 35%;
  float: left;
  height: 80rpx;
  font-size: 30rpx;
  padding: 0;
  line-height: 80rpx;
}

.filter-container .btn:last-child {
  margin: 30rpx 10% 30rpx 5%;
}

.myField .item.vehicleType .input-text::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 15%;
  height: 70%;
  border-left: 1rpx solid #ebedf0;
}

.myField .item.vehicleType picker {
  position: relative;
}

/* 完成页面 */
.finishPage van-icon {
  width: 100%;
}

.finishPage .van-icon {
  color: red;
  margin: 120rpx auto 50rpx;
  font-size: 230rpx;
}

.finishPage .tipText {
  text-align: center;
  font-size: 32rpx;
  color: red;
}

.finishPage .numTip {
  text-align: center;
  margin-top: 40rpx;
  color: #999;
}

.finishPage .con {
  width: 80%;
  margin: 80rpx auto;
  border-top: 1rpx solid #ddd;
  padding: 10rpx;
}

.finishPage .con .item {
  color: #999;
  line-height: 90rpx;
  font-size: 26rpx;
}

.finishView {
  position: fixed;
  bottom: 90rpx;
  left: 10%;
  width: 80%;
  box-sizing: border-box;
}

.finishView button {
  background: red;
  line-height: 76rpx;
  height: 76rpx;
  width: 100%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
}

.finishView .backText {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin-top: 60rpx;
}

/* 底部按钮 */
.footerBtn {
  display: flex;
}

.footerBtn button {
  margin: 0 20rpx;
  flex: 1;
  -webkit-flex: 1;
}

.footerBtn button.preBtn {
  background: none;
  color: #E12006;
  position: relative;
}

.footerBtn button.preBtn::before {
  content: "";
  position: absolute;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #E12006;
  border-radius: 100rpx;
  top: 0;
  left: 0;
}

.goodsInfo {
  position: relative;
  padding-left: 100rpx;
}

.goodsInfo .leftIndex {
  width: 100rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 0.5rpx solid #ebedf0;
  border-right: 0.5rpx solid #ebedf0;
  box-sizing: border-box;
  position: absolute;
  left: 0;
  top: 0;
}


.scorll {
  height: calc(100% - 211rpx);
}

.list {
  padding: 24rpx 30rpx;
  border-radius: 4rpx;
}

.list .item {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}

.list .item .inner {
  padding: 28rpx 24rpx 0;
  border-bottom: 1rpx solid #F6F6F6;
}

.list .item .title {
  margin-bottom: 32rpx;
  font-weight: bold;
}

.list .item .title .router {
  font-size: 32rpx;
  line-height: 40rpx;
  float: left;
}

.list .item .info {
  line-height: 40rpx;
  position: relative;
}

.list .item .info>view {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-bottom: 14rpx;
  display: flex;
}

.list .item .info .text {
  color: #666;
  color: #666;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}

.list .item .info .ipt {
  line-height: 68rpx;
}

.list .item .info .ipt input {
  border: 1rpx solid #eee;
  padding: 10rpx;
}

.list .item .info .price {
  font-size: 34rpx;
  position: absolute;
  right: 0;
  top: 0;
  line-height: 1;
}

.list .item .isUrgent {
  border-radius: 50rpx;
  height: 30rpx;
  width: 60rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #E12006;
  margin: 8rpx 16rpx 0;
}


.wayTitle {
  font-size: 28rpx;
  line-height: 1;
  margin-bottom: 30rpx;
  padding: 30rpx 30rpx 0;
  font-weight: bold;
  position: relative;
}

.costList{
  display: flex;
}

.costList .myField{
  flex:1
}

.costList .opBtns {
  margin: 20rpx 0 0 5rpx;
}

.costList .opBtns .add {
  margin-top: 5rpx;
  font-size: 50rpx;
  color: #1990ff;
  display: block;
}
.costList .opBtns .minus{
  margin: 10rpx 5rpx 20rpx;
  width: 40rpx;
  height: 40rpx;
  background: red;
  display: flex;
  justify-content: center;
  align-items: center;  
  border-radius: 6rpx;
}
.costList .opBtns .minus::after{
  content: "";
  width: 20rpx;
  height: 2rpx;
  background: #fff;
  display: block;
}