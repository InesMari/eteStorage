page{
  background: #f1f2f5;
  padding-bottom: 130rpx;
}

.van-cell__title{
  flex:initial!important;
  -webkit-flex:initial!important;
  max-width: 250rpx!important;
}
.van-cell__value{
  text-align: right;
  color: #333!important;
}
van-radio{
  display: inline-block;
  margin-left: 20rpx;
}

.uploadImg{
  padding:20rpx 30rpx 0;
  margin-top: 20rpx;
  background: #fff;
}
.uploadImg .item{
  float: left;
  width: 200rpx;
  height: 200rpx;
  border-radius: 6rpx;
  margin:0 20rpx 20rpx 0;
}
.uploadImg .item image{
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.footerBtn.btns button{
  margin-left:20rpx;
  font-size: 24rpx;
  padding:0 20rpx;
}

/* 完成页面 */
.finishPage van-icon{
  width: 100%;
}
.finishPage .van-icon{
  color: red;
  margin:120rpx auto 50rpx;
  font-size: 230rpx;
}
.finishPage .tipText{
  text-align: center;
  font-size: 32rpx;
  color: red;
}
.finishPage .numTip{
  text-align: center;
  margin-top: 40rpx;
  color: #999;
}
.finishPage .con{
  width: 80%;
  margin: 80rpx auto;
  border-top: 1rpx solid #ddd;
  padding: 10rpx;
}
.finishPage .con .item{    
  color: #999;
  line-height: 90rpx;
  font-size: 26rpx;
}
.finishView{
  position: fixed;
  bottom:90rpx;
  left: 10%;
  width: 80%;
  box-sizing: border-box;
}
.finishView button{
  background: red;
  line-height: 76rpx;
  height: 76rpx;
  width: 100%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
}
.finishView .backText{
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin-top: 60rpx;
}

.showAlert .content{
  padding: 40rpx 30rpx;
}
.showAlert .content input{
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border:1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}
.showAlert .bottom{
  border-top:1rpx solid #f6f6f6;
}
.showAlert .bottom button{
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}
.showAlert .bottom button:last-child{
  border:none;
}