@import '/assets/purchaseApplyDetail/purchaseApplyDetail.wxss';

.goodsInfo{
  position: relative;
  padding-left: 100rpx;
}
.goodsInfo .leftIndex{
  width: 100rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 0.5rpx solid #ddd;
  border-right: 0.5rpx solid #ebedf0;
  box-sizing: border-box;
  position: absolute;
  left: 0;
  top: 0;
}

.myField .goodsInfo .item:last-child{
  border-bottom: 0.5rpx solid #ddd;
}