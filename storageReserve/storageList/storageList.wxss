page{
  background: #f5f5f5;
  height: 100%;
}
.footerBtn {
  border:none;
  background: none;
  bottom: 50%;
  box-shadow: none;
}
.footerBtn .tip{
  text-align: center;
  line-height: 100rpx;
  color: #999;
}
.scorll{
  height: calc(100% - 400rpx);
}
.list{
  padding: 30rpx 24rpx;
  border-radius: 4rpx;
}
.list .item{
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  padding:24rpx 18rpx;
}
.list .item .header{
  float: left;
  width: 155rpx;
  height: 155rpx;
  border-radius: 10rpx;
  overflow: hidden;
}
.list .item .header image{
  width: 100%;
  height: 100%;
}
.list .item .inner{
  width: calc(100% - 170rpx);
  float:right;
}
.item .title{
  font-weight: bold;
}
.item .title .router{
  font-size: 26rpx;
  line-height: 40rpx;
  float: left;
}
.item .title .state{
  float: right;
  line-height: 40rpx;
  font-size: 24rpx;
  width: 120rpx;
  height: 40rpx;
  background: #0CCBF8;
  border-radius: 50rpx;
  color: #fff;
  font-weight: normal;
  text-align: center;
}
.item .title .state.state1{
  color: #0CCBF8;
  background: #E6F4F9;
}
.item .title .state.state2{
  color: #05D188;
  background: #E6F7F0;
}
.item .title .state.state3{
  color: #C5C5C5;
  background: #F1F2F5;
}
.item .title .state.state5{
  color: #FF7C1C;
  background: #FFDDCB;
}
.item .info{
  line-height: 40rpx;
  position: relative;
}
.item .info>view{
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  line-height: 40rpx;
  display: flex;
}
.item .info .text{
  color: #666;
  color: #666;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}
.item .info .price{
  font-size: 34rpx;
  position: absolute;
  right: 0;
  top: 0;
  line-height: 1;
}
.item .info .iden>view{
  line-height: 40rpx;
  color: #3cc4fd;
  margin-right: 30rpx;
  font-size: 22rpx;
}
.item .info .iden van-icon{
  font-size: 30rpx;
  vertical-align: top;
  margin-top: 7rpx;
  margin-right: 6rpx;
}
.guide image{
  /* position: absolute;
  bottom: 40rpx;
  right: 5rpx;
  width: auto!important;
  color: #3cc4fd;
