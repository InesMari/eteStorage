page{
  background: #f5f5f5;
  height: 100%;
  padding-bottom: 120rpx;
}
.scorll{
  height: calc(100% - 211rpx);
}
.van-tabs__nav{
  width: 950rpx;
}


.showUnPassAlert .content{
  padding: 40rpx 30rpx;
}
.showUnPassAlert .content input{
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border:1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}
.showUnPassAlert .bottom{
  border-top:1rpx solid #f6f6f6;
}
.showUnPassAlert .bottom button{
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}
.showUnPassAlert .bottom button:last-child{
  border:none;
}