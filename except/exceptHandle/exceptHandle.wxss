page {
  background: #f1f2f5;
  padding-bottom: 130rpx;
  padding-top: 110rpx;
}

van-tabs {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 99;
}

.titleTab {
  padding: 20rpx 30rpx;
  background: #fff;
  font-size: 30rpx;
}

.titleInner {
  padding: 15rpx 30rpx;
  background: #fff;
  font-size: 26rpx;
  position: relative;
  font-weight: bold;
}

.van-cell {
  display: block !important;
  border-bottom: 1rpx solid #efefef;
  padding: 8rpx 30rpx !important;
}

.van-cell__title {
  min-width: initial !important;
  max-width: initial !important;
  font-size: 24rpx;
}

.van-cell__value {
  text-align: left !important;
  color: #999 !important;
  font-size: 24rpx;
  padding-left: 12rpx;
}

van-radio {
  display: inline-block;
  margin-right: 30rpx;
}

.van-radio__label {
  margin-left: 10rpx;
}

.uploadImg {
  padding: 20rpx 30rpx 0;
  margin-top: 20rpx;
  background: #fff;
}

.uploadImg .item {
  float: left;
  width: 200rpx;
  height: 200rpx;
  border-radius: 6rpx;
  margin: 0 20rpx 20rpx 0;
}

.uploadImg .item image {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.footerBtn.btns {
  display: flex;
}

.footerBtn.btns button {
  margin-left: 20rpx;
  font-size: 24rpx;
  flex: 1;
  padding: 0 20rpx;
}

.myField .item {
  /* display: block; */
}

.myField .item:last-child::before {
  display: none;
}

.myField .item .label {
  font-size: 24rpx;
  align-items: flex-start;
  min-width: 170rpx;
  max-width: 170rpx;
  position: relative;
}

.myField .item .input-text {
  padding: 0;
  font-size: 24rpx;
}

.myField .item .input-text input {
  font-size: 24rpx;
}

.myField .item .input-text textarea {
  font-size: 24rpx;
  line-height: 1;
  padding: 12rpx 0;
  width: 100%;
}

.myField .item .input-text .type {
  height: 52rpx;
  width: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  float: left;
  margin-right: 12rpx;
}

.myField .item .input-text .type.active {
  background-color: #e70b1d;
  color: #fff;
}
.myField .item .question{
  position: absolute;
  left: 100rpx;
  top: 0;
  font-size: 30rpx;
  color: red;
}

/* 日期 */
datetimepicker {
  display: block;
  width: 100%;
}

datetimepicker picker {
  border: none !important;
  padding: 0 !important;
  height: 52rpx !important;
}

datetimepicker picker .component_placeholder_color,
datetimepicker picker .picker {
  font-size: 24rpx;
}


.uploadImg {
  padding: 20rpx 32rpx;
}

.uploadImg .title {
  /* font-weight: bold; */

}

.uploadImg .title>text {
  color: #999;
  margin-left: 10rpx;
  font-weight: normal;
}

.uploadImg .tip {
  font-size: 24rpx;
  margin: 10rpx 0 20rpx;
  color: #999;
}

.van-uploader__preview-image,
.van-uploader__upload {
  width: 200rpx !important;
  height: 200rpx !important;
}

.van-uploader__preview {
  margin: 0 20rpx 20rpx 0 !important;
}

/* 上传 */
.uploadList .uploadBtn {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 0 8px 8px 0;
  background-color: #f7f8fa;
  position: relative;
  align-items: center;
}

.uploadList .uploadBtn .photograph {
  color: #dcdee0;
  font-size: 50rpx;
}

.uploadList .uploadBtn .upload-text {
  margin-top: 8px;
  color: #969799;
  font-size: 24rpx;
}

.uploadList .uploadItem {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  float: left;
  margin: 0 16rpx 16rpx 0;
}

.uploadList .uploadItem .delect {
  position: absolute;
  top: 0;
  right: 0;
  width: 14px;
  height: 14px;
  padding: 0 0 8px 8px;
}

.uploadList .uploadItem .delect::after {
  position: absolute;
  top: 0;
  right: 0;
  width: 14px;
  height: 14px;
  background-color: rgba(0, 0, 0, .7);
  border-radius: 0 0 0 12px;
  content: "";
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  border-bottom-right-radius: 0px;
  border-bottom-left-radius: 12px;
}

.uploadList .uploadItem .cross {
  position: absolute;
  top: -2px;
  right: -2px;
  z-index: 1;
  color: #fff;
  font-size: 16px;
  -webkit-transform: scale(.5);
  transform: scale(.5);
}
.uploadList .uploadItem image{
  width: 100%;
  height: 100%;
}
.uploadList .uploadItem .videoIcon{
  width: 100%;
  height: 100%;
  display: flex;
  background-color: #000;
  align-items: center;
  justify-content: center;
}
.uploadList .uploadItem .videoIcon .icon{
  font-size: 60rpx;
  color: #fff;
}

/* 视频播放盒子 */
.videoView{
  background-color: #000;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}
.videoView .video{
  width: 100%;
  display: block;
}
.videoView .close{
  font-size: 40rpx;
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  color: #fff;
}
.videoView .btns{
  position: absolute;
  bottom: 50rpx;
  opacity: 0.9;
  display: flex;
  width: 100%;
}
.videoView .btns button{
  font-size: 26rpx;
  width: 220rpx;
}


.showUnPassAlert .content{
  padding: 40rpx 30rpx;
}
.showUnPassAlert .content input{
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border:1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}
.showUnPassAlert .bottom{
  border-top:1rpx solid #f6f6f6;
}
.showUnPassAlert .bottom button{
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}
.showUnPassAlert .bottom button:last-child{
  border:none;
}


.tipView{
  position: absolute;
  top: 50%;
  left: 50%;
  background-color: #fff;
  padding:30rpx;
  border-radius: 10rpx;
  line-height: 50rpx;
  transform: translateX(-50%) translateY(-50%);
  width: 70%;
  word-break: break-all;
}


/* 侧边栏 */
.filter-container{
  height: 100%;
  overflow: hidden;
}
.filter-container input{
  width: 90%;
  display: block;
  margin: 20rpx auto;
  border:1rpx solid #dee2e9;
  border-radius: 6rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 80rpx;
}
.filter-container .title{
  font-weight: bold;
  padding-left: 20rpx;
  margin-top: 40rpx;
  padding-bottom: 10rpx;
}
.filter-container .scrollList{
  height: calc(100% - 140rpx);
}
.filter-container .scrollList .item{
  line-height: 40rpx;
  padding: 20rpx;
  border-bottom: 1rpx solid #dee2e9;
}
.filter-container .scrollList .item:first-child{
  border-top: 1rpx solid #dee2e9;
}
.filter-container .btn{
  margin:30rpx auto;
  width:200rpx;
}