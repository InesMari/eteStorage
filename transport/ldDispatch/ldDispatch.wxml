  </view>
</block>

<!-- 选择车辆 -->
<popover is-show="{{isShowVehiclePopover}}">
  <view class="filter-container">
    <input type="text" placeholder="请输入车牌号" bindinput='searchVehicleList' value="{{vehicleSearch}}"></input>
    <scroll-view class="scrollList" scroll-y="{{true}}">
      <view class="item" wx:for="{{vehicleList}}" wx:key="{{index}}" bindtap="selectVehicle" data-item="{{item}}">{{item.plateNumber}}</view>
    </scroll-view>
    <button type="primary" class="btn" catchtap="selectVehicle">确定</button>
  </view>
</popover>

<!-- 选择司机 -->
<popover is-show="{{isShowDriverPopover}}">
  <view class="filter-container">
    <input type="text" placeholder="请输入司机" bindinput='searchDriveList' value="{{driverSearch}}"></input>
    <scroll-view class="scrollList" scroll-y="{{true}}">
      <view class="item" wx:for="{{driveList}}" wx:key="{{index}}" bindtap="selectDriver" data-item="{{item}}">{{item.driverName}}</view>
    </scroll-view>
    <button type="primary" class="btn" catchtap="selectDriver">确定</button>
  </view>
</popover>