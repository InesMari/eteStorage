
.list{
  padding:0 30rpx;
  position: relative;
  overflow: hidden;
  margin-top: 74rpx;
}
.list::before{
  content: "";
  position: absolute;
  left: 146rpx;
  border-left: 1rpx solid #999;
  height: calc(100% - 130rpx);
  top: 27rpx;
}
.list .item{
  position: relative;
  margin-bottom:60rpx;
}
.state-img{
  position: absolute;
  height: 34rpx;
  width: 34rpx;
  left: 100rpx;
  top: 0;
}
.list .item .content{
  float: left;
  width: calc(100% - 220rpx);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-left: 50rpx;
}
.list .item .content .name{
  font-size: 28rpx;
}
.list .item .content .site{
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}
.list .item .state{
  float:left;
  width: 90rpx;
  line-height: 28rpx;
  font-size:24rpx;
  text-align: right;
  margin-right: 12rpx;
} 
.list .item .num{
  float:right;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border:1rpx solid #E12006;
  text-align: center;
  border-radius: 8rpx;
  color:#E12006;
} 
.list .item .num.disabled{
  border-color: #C5C5C5;
  color: #C5C5C5;
  pointer-events: none;
}