page {
  background: #f5f5f5;
  height: 100%;
}

.scorll {
  height: calc(100% - 211rpx);
}

.list {
  padding: 24rpx 30rpx;
  border-radius: 4rpx;
}

.list .item {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}

.list .item .inner {
  padding: 28rpx 24rpx 0;
  border-bottom: 1rpx solid #F6F6F6;
}

.item .title {
  margin-bottom: 32rpx;
  font-weight: bold;
}

.item .title .router {
  font-size: 32rpx;
  line-height: 40rpx;
  float: left;
}

.item .title .state {
  float: right;
  line-height: 40rpx;
  font-size: 24rpx;
  width: 120rpx;
  height: 40rpx;
  background: #FFCDCD;
  border-radius: 50rpx;
  color: #E60012;
  text-align: center;
}

.item .title .state.state1 {
  color: #0CCBF8;
  background: #E6F4F9;
}

.item .title .state.state2 {
  color: #05D188;
  background: #E6F7F0;
}

.item .title .state.state3 {
  color: #C5C5C5;
  background: #F1F2F5;
}

.item .title .state.state5 {
  color: #FF7C1C;
  background: #FFDDCB;
}

.item .info {
  line-height: 40rpx;
  position: relative;
}

.item .info>view {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-bottom: 14rpx;
  display: flex;
}

.item .info .text {
  color: #666;
  color: #666;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}

.item .info .text.link {
  color: #0CCBF8;
  text-decoration: underline;
}

.item .info .price {
  font-size: 34rpx;
  position: absolute;
  right: 0;
  top: 0;
  line-height: 1;
}

.item .isUrgent {
  border-radius: 50rpx;
  height: 30rpx;
  width: 60rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #E12006;
  margin: 8rpx 16rpx 0;
}

.operate {
  padding: 18rpx 24rpx;
}

.operate .time {
  line-height: 56rpx;
  font-size: 26rpx;
}

.operate .btn {
  background: #fff;
  line-height: 54rpx;
  height: 56rpx;
  border-radius: 50rpx;
  color: #E60012;
  font-size: 28rpx;
  width: 180rpx;
  box-sizing: border-box;
}

.operate .btn::after {
  border: 1rpx solid #E60012;
}

/* 小程序码弹窗样式 */
.code-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-dialog .mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.code-dialog .dialog-content {
  position: relative;
  width: 600rpx;
  max-height: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  z-index: 1;
  overflow: hidden;
}

.orderView {
  background: linear-gradient(135deg, #e70b1d 0%, #c41a2e 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.orderView .orderHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.orderView .orderHeader .logo {
  height: 70rpx;
}

.orderView .orderHeader .oderNumInfo {
  text-align: right;
}

.orderView .orderHeader .oderNumInfo .name {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.orderView .orderHeader .oderNumInfo .value {
  font-size: 32rpx;
  font-weight: 600;
}

.orderView .oderInfo {
  margin-bottom: 30rpx;
}

.orderView .oderInfo .item {
  display: flex;
  margin-bottom: 10rpx;
}

.orderView .oderInfo .item .label {
  width: 160rpx;
  font-weight: 500;
  font-size: 28rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.orderView .oderInfo .item .text {
  flex: 1;
}

.orderView .oderInfo .item .text .site {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 500;
}

.orderView .oderInfo .item .text .tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
}

.orderView .codeView {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.orderView .codeView .title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e70b1d;
}

.orderView .codeView .code-img {
  width: 300rpx;
  margin:0 auto 30rpx;
}

.orderView .codeView .tip view {
  margin: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}

.orderView .codeView .tip view:first-child {
  font-weight: 500;
  color: #333;
}

.dialog-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dialog-footer .close-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 0;
}

.dialog-footer .close-btn {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  background: #E5E5E5;
  color: #666;
  padding: 0;
}