page {
  background: #f1f2f5;
  padding-bottom: 130rpx;
  padding-top: 110rpx;
}

van-tabs {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9;
}

.titleTab {
  padding: 20rpx 30rpx;
  background: #fff;
  font-size: 30rpx;
}

.titleInner {
  padding: 15rpx 30rpx;
  background: #fff;
  font-size: 26rpx;
  position: relative;
  font-weight: bold;
}

.van-cell {
  display: block !important;
  border-bottom: 1rpx solid #efefef;
  padding: 8rpx 30rpx !important;
}

.van-cell__title {
  min-width: initial !important;
  max-width: initial !important;
  font-size: 24rpx;
}

.van-cell__value {
  text-align: left !important;
  color: #999 !important;
  font-size: 24rpx;
  padding-left: 12rpx;
}

van-radio {
  display: inline-block;
  margin-right: 30rpx;
}

.van-radio__label {
  margin-left: 10rpx;
}

.uploadImg {
  padding: 20rpx 30rpx 0;
  margin-top: 20rpx;
  background: #fff;
}

.uploadImg .item {
  float: left;
  width: 200rpx;
  height: 200rpx;
  border-radius: 6rpx;
  margin: 0 20rpx 20rpx 0;
}

.uploadImg .item image {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.footerBtn.btns {
  display: flex;
}

.footerBtn.btns button {
  margin-left: 20rpx;
  font-size: 24rpx;
  flex: 1;
  padding: 0 20rpx;
}

.myField .item {
  display: block;
}

.myField .item:last-child::before {
  display: none;
}

.myField .item .label {
  max-width: initial;
  font-size: 24rpx;
  width: 100%;
  display: block;
}

.myField .item .input-text {
  padding: 0;
}

.myField .item .input-text input {
  font-size: 24rpx;
}

datetimepicker {
  display: block;
  width: 100%;
}

datetimepicker picker {
  border: none !important;
  padding: 0 !important;
}

datetimepicker picker .component_placeholder_color,
datetimepicker picker .picker {
  font-size: 24rpx;
}

.remarkArea {
  background: #fff;
  height: 150rpx;
  margin: 20rpx;
  width: initial;
  display: block;
  box-sizing: border-box;
  border-radius: 20prx;
  padding: 20rpx;
}

.uploadImg{
  padding: 20rpx 32rpx;
}
.uploadImg .title{
  /* font-weight: bold; */

}
.uploadImg .title>text{
  color: #999;
  margin-left: 10rpx;
  font-weight: normal;
}
.uploadImg .tip{
  font-size: 24rpx;
  margin:10rpx 0 20rpx;
  color: #999;
}
.van-uploader__preview-image,.van-uploader__upload{
  width: 200rpx!important;
  height: 200rpx!important;
}
.van-uploader__preview{
  margin: 0 20rpx 20rpx 0!important;
}

/* 完成页面 */
.finishPage van-icon {
  width: 100%;
}

.finishPage .van-icon {
  color: red;
  margin: 120rpx auto 50rpx;
  font-size: 230rpx;
}

.finishPage .tipText {
  text-align: center;
  font-size: 32rpx;
  color: red;
}

.finishPage .numTip {
  text-align: center;
  margin-top: 40rpx;
  color: #999;
}

.finishPage .con {
  width: 80%;
  margin: 80rpx auto;
  border-top: 1rpx solid #ddd;
  padding: 10rpx;
}

.finishPage .con .item {
  color: #999;
  line-height: 90rpx;
  font-size: 26rpx;
}

.finishView {
  position: fixed;
  bottom: 90rpx;
  left: 10%;
  width: 80%;
  box-sizing: border-box;
}

.finishView button {
  background: red;
  line-height: 76rpx;
  height: 76rpx;
  width: 100%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
}

.finishView .backText {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin-top: 60rpx;
}

.showUnPassAlert .content {
  padding: 40rpx 30rpx;
}

.showUnPassAlert .content input {
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}

.showUnPassAlert .bottom {
  border-top: 1rpx solid #f6f6f6;
}

.showUnPassAlert .bottom button {
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right: 1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}

.showUnPassAlert .bottom button:last-child {
  border: none;
}