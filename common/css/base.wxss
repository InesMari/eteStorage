/*  
#1990ff;  //主体颜色
#2e9aff;  //主体颜色经过辅色
#333333;  //主要字体颜色
#666666;  //普通字体颜色
#999999;  //次要字体颜色
#c5c5c5;  //placeholder颜色
#f6f6f6;  //边线颜色
