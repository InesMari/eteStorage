<wxs src="../../common/wxs/format.wxs" module="format"></wxs>

<view class="contain">
  <view class="headInfo">
    <image class="bg" src="/common/images/info_bg.png"></image>
    <view class="userInfo" bindtap="goback">
      <image class="back" src="/common/images/back.png" mode="widthFix"></image>
    </view>
    <view class="workName">运力管理</view>
  </view>
  <view class="list clearfix">
    <view  class="item" bindtap="toVehicle" wx:if="{{entitys[1002017]}}">
      <image src="/common/images/i_14.png"></image>
      <view class="name">车辆管理</view>
      <view class="explain">查询、新增、监控车辆</view>
    </view>
    <view  class="item" bindtap="toDriver" wx:if="{{entitys[1002018]}}">
      <image src="/common/images/i_15.png"></image>
      <view class="name">司机管理</view>
      <view class="explain">查询、新增司机</view>
    </view>
  </view>
</view>
