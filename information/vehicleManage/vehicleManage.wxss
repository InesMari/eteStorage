page{
  background: #f5f5f5;
  height: 100%;
  padding-bottom: 0rpx;
  box-sizing: border-box;
}
.scorll{
  height: calc(100% - 200rpx);
}
.disabled{
  background: #eee!important;
}
.unlock{
  position: absolute;
  top: 60rpx;
  right: 0;
  width: 50rpx;
  padding:30rpx;
  z-index: 9;
}
.footerBtn.btns.btnsThree{
  display: flex;
}
.footerBtn.btns.btnsThree button{
  padding: 0 36rpx;
  font-size: 28rpx;
  margin: 0 20rpx;
  flex: 1;
}
.comList .info .editView{
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  padding:0 50rpx 0 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0;
  z-index: 99;
}
.comList .info .edit{
  font-size: 50rpx;
  color: green;
}