page{
  background: #f5f5f5;
  height: 100%;
  padding-bottom: 0rpx;
  box-sizing: border-box;
}
.scorll{
  height: calc(100% - 200rpx);
}
.disabled{
  background: #eee!important;
}
.comList .info .editView{
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  padding:0 50rpx 0 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0;
}
.comList .info .edit{
  font-size: 50rpx;
  color: green;
}