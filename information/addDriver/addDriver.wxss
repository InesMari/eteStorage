page{
  background: #f5f5f5;
  padding-bottom: 120rpx;
}
.van-uploader{
  float: left;
}
.red .van-field__input{
  color:red;
}

.filter-container {
  height: 100%;
}

.filter-container input {
  width: 90%;
  display: block;
  margin: 20rpx auto;
  border: 1rpx solid #dee2e9;
  border-radius: 6rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 80rpx;
}

.filter-container .scrollList {
  height: calc(100% - 280rpx);
}

.filter-container .scrollList .item {
  line-height: 40rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #dee2e9;
}

.filter-container .scrollList .item.active {
  color: #fff;
  background: #1990ff;
}

.filter-container .scrollList .item:first-child {
  border-top: 1rpx solid #dee2e9;
}

.filter-container .btn {
  margin: 30rpx 5% 30rpx 10%;
  width: 35%;
  float: left;
  height: 80rpx;
  font-size: 30rpx;
  padding: 0;
  line-height: 80rpx;
}

.filter-container .btn:last-child {
  margin: 30rpx 10% 30rpx 5%;
}

