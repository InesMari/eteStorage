<wxs src="../../common/wxs/format.wxs" module="format"></wxs>
<view class="banner">
  <image src="/common/images/quesBanner.png" mode="widthFix" alt=""></image>
</view>
<view class="startWord">
  <text>{{info.startWords}}</text>
</view>
<view class="putTable clearfix">
  <view class="item">
    <view class="label">客服名称</view>
    <view class="input-text">
      {{info.putUserName}}
    </view>
  </view>
  <view class="item">
    <view class="label">客服手机</view>
    <view class="input-text">
      {{info.putUserPhone}}
    </view>
  </view>
  <view class="item" style="width: 100%;">
    <view class="label">仓库名称</view>
    <view class="input-text">
      {{info.putUserWorkName}}
    </view>
  </view>
</view>

<view class="putTable clearfix">
  <view class="row">
    <view>服务时长</view>
    <view>服务天数</view>
    <view>满意率</view>
  </view>
  <view class="row">
    <view>{{info.serviceDuration}}</view>
    <view>{{info.serviceDay}}</view>
    <view>{{info.satisfactionRate}}</view>
  </view>
</view>

<view class="title" style="padding:18rpx 30rpx 0;">5星累计评价</view>
<view class="putTable clearfix">
  <view class="item">
    <view class="label">文明有礼貌</view>
    <view class="input-text">
      {{format.formatToZero(info.civilizationCount)}}
    </view>
  </view>
  <view class="item">
    <view class="label">服务态度好</view>
    <view class="input-text">
      {{format.formatToZero(info.serviceCount)}}
    </view>
  </view>
  <view class="item">
    <view class="label">解决问题及时</view>
    <view class="input-text">
      {{format.formatToZero(info.solveCount)}}
    </view>
  </view>
  <view class="item">
    <view class="label">专业敬业</view>
    <view class="input-text">
      {{format.formatToZero(info.professionalCount)}}
    </view>
  </view>
  <view class="item" style="width: 100%;">
    <view class="label">语言流畅</view>
    <view class="input-text">
      {{format.formatToZero(info.languageCount)}}
    </view>
  </view>
</view>

<view></view>

