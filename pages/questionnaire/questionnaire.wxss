.banner{
  padding:0 30rpx 30rpx;
}
.banner image{
  width: 100%;
}
.startWord{
  padding:0 30rpx 18rpx;
  line-height: 40rpx;
  font-size: 24rpx;
}
.putTable{
  margin:18rpx 30rpx;
  border-left:1rpx solid #eee;
  border-top:1rpx solid #eee;
}
.putTable .item{
  width: 50%;
  display: flex;
  float: left;
}
.putTable .label{
  width: 150rpx;
  background: #f5f5f5;
  line-height: 60rpx;
  font-size: 24rpx;
  text-align: center;
}
.putTable .input-text{
  flex: 1;
  border-right:1rpx solid #eee;
  border-bottom:1rpx solid #eee;
  line-height: 60rpx;
  font-size: 24rpx;
  text-align: center;
}
.putTable .row{
  display: flex;
  height: 60rpx;
}
.putTable .row>view{
  flex: 1;
  font-size: 24rpx;
  border-right:1rpx solid #eee;
  border-bottom:1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}
.myField {
  margin-bottom: 40rpx;
}
.myField .item {
  display: block;
}
.myField .item .label{
  max-width:100%;
  width: 100%;
  float: inital;
}
.myField .item .input-text{
  padding: 0;
  margin-top: 6prx;
}
.questionList{
  padding:18rpx 30rpx;
}
.title{
  font-size: 28rpx;
  font-weight: bold;
}
.questionList .innerQues{
  margin-bottom: 20rpx;
}
.questionList .suggest{
  border:1rpx solid #eee;
  padding: 10rpx;
  margin: 16rpx 0;
}
.questionList .innerTitle{
  line-height: 50rpx;
  font-size: 24rpx;
  margin-top: 20rpx;
}
.questionList .titleRadio{
  padding:20rpx 0;
}
.questionList .answer{
  margin-top: 10rpx;
}
.questionList .van-radio{
  margin-right: 20rpx;
}
.questionList .van-radio__label{
  margin-left: 4rpx!important;
  font-size: 24rpx;
}
.submit{
  background: #E12006;
  line-height: 74rpx;
  height: 76rpx;
  width: 90%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
  margin:40rpx auto;
}

.aboutme{
  padding:18rpx 30rpx;
}
.aboutme view{
  color: #999;
  line-height: 40rpx;
  font-size: 24rpx;
}
.aboutme text{
  margin-left: 40rpx;
}
.company{
  font-size: 30rpx;
  line-height: 150rpx;
  color: #999;
  text-align: center;
}

.endView{
  position: fixed;
  width: 100%;
  height: 100%;
  background: #fff;
  top: 0;
  left: 0;
  z-index: 999;
}
.endView .content{
  position: absolute;
  top: 30%;
  left: 0;
  width: 100%;
}
.endView image{
  width: 300rpx;
  margin:0 auto 50rpx;
}
.endView .content>view{
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
}
.endView .endViewCompany{
  position: absolute;
  bottom: 50rpx;
  left: 0;
  width: 100%;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
}