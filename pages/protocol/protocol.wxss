view{margin:0; padding:0; list-style-type:none;font-weight:normal;} 
.box{background:#fff;}
a{text-decoration: none;}
.top{ height:53px; background:#E50012; line-height:53px; font-size:18px; position:relative; color:#fff; text-align:center;}
.top img{width:26px; height:26px; position:absolute; top:13px; left:13px; }
.top h2{ font-size:18px; line-height:53px;}
.content{padding:20px 15px 30px;}
.content-h1{font-size:16px;font-weight:bold; text-align:center;}
.content-h3{font-size:14px; text-align:center; margin-bottom:15px;color: #333;}
.content-h4{font-size:14px; font-weight:bold; text-indent:24px; margin-top:10px;}
.content h6{font-size:14px; text-indent:24px; line-height:25px;}
.content-p{ text-indent:24px; font-size:12px; line-height:20px; text-align:justify;}