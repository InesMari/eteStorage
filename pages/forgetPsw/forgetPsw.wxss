.list .item{
  width: 90rpx;
  height: 90rpx;
  border: 1rpx solid #dee2e9;
  border-radius: 5rpx;
  background: #fff;
  float: left;
  box-sizing: border-box;
  margin-right:20rpx;
}
.list .item input{
  height: 100%;
  width: 100%;
  text-align: center;
  font-size: 34rpx;
}