page {
  background: #f1f2f5;
  padding-bottom: 130rpx;
  padding-top: 110rpx;
}
van-tabs{
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 999;
}
.titleTab {
  padding: 20rpx 30rpx;
  background: #fff;
  font-size: 30rpx;
}

.titleInner {
  padding: 15rpx 30rpx;
  background: #fff;
  font-size: 26rpx;
  position: relative;
  font-weight: bold;
}
.van-cell{
  display: block!important;
  border-bottom: 1rpx solid #efefef;
  padding:8rpx 30rpx!important;
}
.van-cell__title {
  min-width: initial !important;
  max-width: initial !important;
  font-size: 24rpx;
}

.van-cell__value {
  text-align: left!important;
  color: #999 !important;
  font-size: 24rpx;
  padding-left: 12rpx;
}

.van-cell-image{
  width:200rpx;
  height: 200rpx;
  border-radius: 6rpx;
}
van-radio,van-checkbox {
  display: inline-block;
  margin-right: 30rpx;
}
.van-radio__label,.van-checkbox__label{
  margin-left:10rpx;
  color: #999!important;
}

.uploadImg {
  padding: 20rpx 30rpx 0;
  margin-top: 20rpx;
  background: #fff;
}

.uploadImg .item {
  float: left;
  width: 200rpx;
  height: 200rpx;
  border-radius: 6rpx;
  margin: 0 20rpx 20rpx 0;
}

.uploadImg .item image {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.footerBtn.btns {
  display: flex;
}

.footerBtn.btns button {
  margin-left: 20rpx;
  font-size: 24rpx;
  flex: 1;
  padding: 0 20rpx;
}

.myField .item:last-child::before {
  display: none;
}
.myField .item{
  display: block;
}
.myField .item .label {
  max-width: initial;
  float: initial;
  font-size: 24rpx;
}
.myField .item .input-text{
  font-size: 24rpx;
  border-bottom: 1rpx dashed #efefef;
  color: #999;
}
.myField .item .input-text:last-child{
  border:none;
}
.myField .item .input-text text{
  display: inline-block;
  width: 126rpx;
}
/* 完成页面 */
.finishPage van-icon {
  width: 100%;
}

.finishPage .van-icon {
  color: red;
  margin: 120rpx auto 50rpx;
  font-size: 230rpx;
}

.finishPage .tipText {
  text-align: center;
  font-size: 32rpx;
  color: red;
}

.finishPage .numTip {
  text-align: center;
  margin-top: 40rpx;
  color: #999;
}

.finishPage .con {
  width: 80%;
  margin: 80rpx auto;
  border-top: 1rpx solid #ddd;
  padding: 10rpx;
}

.finishPage .con .item {
  color: #999;
  line-height: 90rpx;
  font-size: 26rpx;
}

.finishView {
  position: fixed;
  bottom: 90rpx;
  left: 10%;
  width: 80%;
  box-sizing: border-box;
}

.finishView button {
  background: red;
  line-height: 76rpx;
  height: 76rpx;
  width: 100%;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 50rpx;
}

.finishView .backText {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin-top: 60rpx;
}

.showAlert .content {
  padding: 40rpx 30rpx;
}

.showAlert .content input {
  height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid #3894ff;
  border-radius: 6rpx;
  margin-top: 20rpx;
}

.showAlert .bottom {
  border-top: 1rpx solid #f6f6f6;
}

.showAlert .bottom button {
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right: 1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}

.showAlert .bottom button:last-child {
  border: none;
}

.stepViewRow{
  display: flex;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.stepViewRow .item{
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  flex:1;
  position: relative;
}
.stepViewRow .item::after{
  content: "";
  position: absolute;
  top:62rpx;
  left: 50%;
  border-bottom: 1rpx dashed #1990ff;
  width: 100%;
}

.stepViewRow .item.ispass::after{
  border-bottom: 1rpx solid #1990ff;
}
.stepViewRow .item:last-child:after{
  display: none;
}
.stepViewRow .icon{
  display: inline-block;
  width: 50rpx;
  font-size: 28rpx;
  background-color: #fff;
  position: relative;
  top: 6rpx;
  z-index: 99;
}
.stepViewRow .date{
  color: #999;
}


/* 流程 */
.stepView{
  background: #fff;
  padding: 0 20rpx 0 80rpx;
  margin-bottom: 20rpx;
}
.stepView .item{
  line-height: 40rpx;
  font-size: 24rpx;
  position: relative;
  border-bottom: 1rpx dashed #f5f5f5;
  padding: 20rpx 0;
}
.stepView .item:last-child{
  border-bottom: none;
}
.stepView .item::after{
  content: "";
  position: absolute;
  top:26rpx;
  left: -36rpx;
  border-left: 1rpx dashed #1990ff;
  height: 100%;
}

.stepView .item.ispass::after{
  border-left: 1rpx solid #1990ff;
}
.stepView .item:last-child:after{
  display: none;
}
.stepView .icon{
  display: inline-block;
  height: 32rpx;
  font-size: 28rpx;
  background-color: #fff;
  position: relative;
  top: 26rpx;
  left: -50rpx;
  z-index: 99;
  position: absolute;
}
.stepView .date{
  color: #999;
}
