<wxs src="../../common/wxs/format.wxs" module="format"></wxs>
<block wx:if="{{!showFinish}}">
<van-tabs active="{{active}}" bind:click="toScroll">
  <van-tab title="基本信息"></van-tab>
  <van-tab title="合同信息"></van-tab>
</van-tabs>
<!-- <view class="stepViewRow">
  <view wx:for="{{info.reviewUserList}}" class="item {{item.reviewSts==2?'ispass':''}}">
    <view class="org">{{item.orgName}}</view>
    <view class="icon">
      <van-icon name="underway-o" wx:if="{{item.reviewSts == 1}}" style="color: #999;"/>
      <van-icon name="passed" wx:if="{{item.reviewSts == 2}}" style="color: green;" />
      <van-icon name="close" wx:if="{{item.reviewSts == 3}}" style="color: red;" />
    </view>
    <view class="staff">{{item.userName}}</view>
    <view class="date">{{format.formatEmpty(item.reviewDate)}}</view>
  </view>
</view> -->
<view class="mb_20"></view>
<view class="titleTab" id="base">基本信息</view>
<van-cell-group>
  <van-cell title="*合同评审编码" value="{{info.contractNum}}" />
  <van-cell title="*供应商名称" value="{{info.tenantName}}" />
  <van-cell title="*结算主体" value="{{info.settleBodyName}}" />
</van-cell-group>
<van-cell-group>
  <van-cell title="*合同评审类型" value="{{format.formatTo_(info.contractTypeName)}}" />
  <van-cell title="*合同类型" value="{{format.formatTo_(info.contractParentTypeName)}}" />
  <van-cell title="*申请人" value="{{format.formatTo_(info.createUserName)}}" />
  <van-cell title="*申请部门" value="{{format.formatTo_(info.orgName)}}" />
  <van-cell title="*申请事由" value="{{format.formatTo_(info.remark)}}" />
  <van-cell title="*评审  日期" value="{{format.formatTo_(info.createDate)}}" />
  <!-- <van-cell title="*评审人员" value="{{format.formatTo_(info.userName)}}" /> -->
  <!-- <van-cell title="*评审截止日期" value="{{format.formatTo_(info.expireDate)}}" /> -->
  <van-cell title="*评审状态" value="{{format.formatTo_(info.stsName)}}" />
</van-cell-group>
<view class="titleTab mt_20" id="constract">合同信息</view>

<!-- 旧的 -->
<block wx:if="{{(info.contractType != 9 && info.contractType != 3 && info.contractType != 4 && info.contractType != 5 && info.contractType != 6 && info.contractType != 7 && info.contractType != 8) || info.isOld}}">
  <view class="titleInner pt_30">丨供应商主体资质审查</view>
  <van-cell-group>
    <van-cell title="*运输区域" value="{{format.formatTo_(info.transitAreasName)}}" />
    <van-cell title="*相关执照">
      <van-radio-group value="{{ info.certificate }}" >
        <block wx:for="{{certificate}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
    </van-cell>
    <van-cell title="*相关资质" value="{{format.formatTo_(info.qualificationName)}}" />
    <van-cell title="*成立日期" value="{{format.formatTo_(info.establishmentDate)}}" />
    <van-cell title="*注册资本" value="{{format.formatTo_(info.registeredCapital)}}" />
    <van-cell title="*注册地址" value="{{format.formatTo_(info.registeredAddress)}}" />
    <van-cell title="*垫资能力" value="{{format.formatTo_(info.provideLoansName)}}" />
  </van-cell-group>
  <view class="titleInner pt_30">丨服务或资质要求与风险防范</view>
  <van-cell-group>
    <van-cell title="*产品类：生产许可、产品检测报告、质量认证">
      <van-radio-group value="{{ info.prods }}" >
        <block wx:for="{{haveOrNot}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
    </van-cell>
    <van-cell title="*体系认证及安全：ISO 质量认证体系、安全、消防资质">
      <van-radio-group value="{{ info.systemCertification }}" >
        <block wx:for="{{haveOrNot}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
    </van-cell>
    <van-cell title="*场地（厂房）房屋产权证">
      <van-radio-group value="{{ info.certificateOfTitle }}" >
        <block wx:for="{{haveOrNot}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
    </van-cell>
    <van-cell title="*是否相关保险（车辆险、运输险、货物险、财产险）">
      <van-radio-group value="{{ info.insurance }}" >
        <block wx:for="{{haveOrNot}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
    </van-cell>
    <van-cell title="*合作风险防范措施/方案">
      <van-radio-group value="{{ info.riskPlan }}" >
        <block wx:for="{{haveOrNot}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
      {{ info.riskPlanRemark }}
    </van-cell>
    <van-cell title="*履约期限" value="{{info.keepStartDate}} 至 {{info.keepEndDate}}" />
    <van-cell title="*合同纠纷法院" value="{{format.formatTo_(info.disputeCourt)}}" />
  </van-cell-group>
</block>
<!-- 旧的 -->
<!-- 仓储租赁 -->
<block wx:if="{{info.contractType == 9 && !info.isOld}}">
  <view class="titleInner">丨仓储租赁</view>
  <van-cell-group>
    <van-cell title="*合同类别" value="{{format.formatTo_(info.contractClassName)}}" />
    <van-cell title="*仓库名称" value="{{format.formatTo_(info.workName)}}" />
    <van-cell title="*租赁面积" value="{{format.formatTo_(info.leaseArea)}}" />
    <van-cell title="*仓库总面积" value="{{format.formatTo_(info.storeHouseArea)}}" />
    <van-cell title="*管理费" value="{{format.formatTo_(info.manageFee)}}" />
    <van-cell title="*其他费用" value="{{format.formatTo_(info.otherFee)}}" />
    <van-cell title="*月度费用" value="{{format.formatTo_(info.monthFee)}}" />
    <van-cell title="*其他费用" value="{{format.formatTo_(info.otherFee)}}" />
    <van-cell title="*仓库消防等级">
      <van-radio-group value="{{ info.storeHouseFireGrade }}" >
        <block wx:for="{{storeHouseFireGradeData}}">
          <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
        </block>
      </van-radio-group>
    </van-cell>
    <van-cell title="*租赁合同期限">
      {{format.getDate(info.keepStartDate)}} ~ {{format.getDate(info.keepEndDate)}}
    </van-cell>
    <van-cell title="*客户合同期限">
      {{format.getDate(info.customerContractDateBegin)}} ~ {{format.getDate(info.customerContractDateEnd)}}
    </van-cell>
    <van-cell title="*营业执照">
      <fileviewer url="{{info.businessLicenseFileUrl}}"></fileviewer>
    </van-cell>
    <van-cell title="*消防验收证明">
      <fileviewer url="{{info.fireInspectionCertificateFileUrl}}"></fileviewer>
    </van-cell>
    <van-cell title="*房产证">
      <fileviewer url="{{info.propertyOwnershipCertificateFileUrl}}"></fileviewer>
    </van-cell>
    <van-cell title="*物品移交表">
      <fileviewer url="{{info.deliveryMaterielListFileUrl}}"></fileviewer>
    </van-cell>
    <van-cell title="*房东身份证复制件" style="display: flex;">
      <fileviewer url="{{info.idCardFrontFileUrl}}"></fileviewer>
      <fileviewer url="{{info.idCardBackFileUrl}}"></fileviewer>
    </van-cell>
    <van-cell title="*房屋布局图">
      <fileviewer url="{{info.housePlanFileUrl}}"></fileviewer>
    </van-cell>
  </van-cell-group>  
</block>
<!-- 仓储租赁 -->
<!-- 仓储服务 -->
<block wx:if="{{(info.contractType >= 3 && info.contractType <= 7) && !info.isOld}}">
  <view class="titleInner">丨仓储服务</view>
  <van-cell-group>
    <van-cell title="*合同类别" value="{{format.formatTo_(info.contractClassName)}}" />
    <van-cell title="*仓库名称" value="{{format.formatTo_(info.workName)}}" />
    <van-cell title="*月度费用" value="{{format.formatTo_(info.monthFee)}}" />
    <van-cell title="*合同期限">
      {{format.getDate(info.keepStartDate)}} ~ {{format.getDate(info.keepEndDate)}}
    </van-cell>
    <van-cell title="*营业执照">
      <fileviewer url="{{info.businessLicenseFileUrl}}"></fileviewer>
    </van-cell>
  </van-cell-group>  
</block>
<!-- 仓储服务 -->
<!-- 保险 -->
<block wx:if="{{info.contractType == 8 && !info.isOld}}">
  <view class="titleInner">丨保险信息</view>
  <van-cell-group>
    <van-cell title="*保险类别" value="{{format.formatTo_(info.contractContentName)}}" />
    <van-cell title="*保险内容" value="{{format.formatTo_(info.contractContentValue)}}" />
    <van-cell title="*保险对象中心" value="{{format.formatTo_(info.workName)}}" />
    <van-cell title="*保险期限" value="{{format.formatTo_(info.keepDate)}}" />
  </van-cell-group>  
  <view class="titleInner">丨保险公司信息</view>
  <van-cell-group>
    <van-cell title="*法定代表人" value="{{format.formatTo_(info.legalRepresentative)}}" />
    <van-cell title="*经营范围" value="{{format.formatTo_(info.businessScope)}}" />
    <van-cell title="*成立日期" value="{{format.formatTo_(info.dateEstablishment)}}" />
    <van-cell title="*注册地址" value="{{format.formatTo_(info.insuranceRegisteredAddress)}}" />
    <van-cell title="*营业执照">
      <fileviewer url="{{info.businessLicense9FileUrl}}"></fileviewer>
    </van-cell>
  </van-cell-group>
  <view class="titleInner">丨保险代理机构信息</view>
  <van-cell-group>
    <van-cell title="*代理机构姓名" value="{{format.formatTo_(info.agentName)}}" />
    <van-cell title="*代理机构电话" value="{{format.formatTo_(info.agentBill)}}" />
    <van-cell title="*法定代表人" value="{{format.formatTo_(info.agentLegalRepresentative)}}" />
    <van-cell title="*经营范围" value="{{format.formatTo_(info.agentBusinessScope)}}" />
    <van-cell title="*成立日期" value="{{format.formatTo_(info.agentDateEstablishment)}}" />
    <van-cell title="*注册地址" value="{{format.formatTo_(info.agentRegisteredAddress)}}" />
    <van-cell title="*营业执照">
      <fileviewer url="{{info.businessLicense3FileUrl}}"></fileviewer>
    </van-cell>
  </van-cell-group>  
</block>
<!-- 保险 -->

<!-- 保险结款 -->
<block wx:if="{{info.contractType == 8 && !info.isOld}}">
<view class="titleInner pt_30">丨结款条件</view>
<van-cell-group>
  <van-cell title="*付款方式">
    <van-radio-group value="{{ info.payMode }}" >
      <block wx:for="{{contractPayMode}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
  </van-cell>
  <van-cell title="*付款条件">
    <van-radio-group value="{{ info.payCondition }}" >
      <block wx:for="{{payConditionData}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
    <text style="margin-left: 30rpx;">请列出： {{format.formatTo_(info.payConditionValue)}} </text>
  </van-cell>
  <van-cell title="*发票">
    <van-radio-group value="{{ info.invoiceType }}" >
      <block wx:for="{{contractInvoiceType}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
  </van-cell>
  <van-cell title="*税率">
    <van-checkbox-group value="{{ info.taxRate }}" >
      <block wx:for="{{taxRate}}">
        <van-checkbox name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-checkbox>
      </block>
    </van-checkbox-group>
  </van-cell>
</van-cell-group>
</block>
<!-- 保险结款 -->

<!-- 其他结款 -->
<block wx:if="{{!(info.contractType == 8 && !info.isOld)}}">  
<view class="titleInner pt_30">丨结款条件</view>
<van-cell-group>
  <van-cell title="*付款方式">
    <van-radio-group value="{{ info.payMode }}" >
      <block wx:for="{{contractPayMode}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
  </van-cell>
  <van-cell title="*对账" value="{{'每月'+info.reconciliationDate+'号前对账，每月'+info.invoiceDate+'号前交发票。'}}" />
  <van-cell title="*发票">
    <van-radio-group value="{{ info.invoiceType }}" >
      <block wx:for="{{contractInvoiceType}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
  </van-cell>
  <van-cell title="*税率">
    <van-checkbox-group value="{{ info.taxRate }}" >
      <block wx:for="{{taxRate}}">
        <van-checkbox name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-checkbox>
      </block>
    </van-checkbox-group>
  </van-cell>
  <van-cell title="*账期见票结">
    <van-radio-group value="{{ info.accountPeriod }}" >
      <block wx:for="{{accountPeriod}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
  </van-cell>
  <van-cell title="*押金">
    <van-radio-group value="{{ info.deposit }}" >
      <block wx:for="{{haveOrNot}}">
        <van-radio name="{{item.codeValue}}" shape="square" icon-size="24rpx">{{item.codeName}}</van-radio>
      </block>
    </van-radio-group>
    <text style="margin-left: 30rpx;">支付/退回期限 {{format.formatTo_(info.returnDate)}} 天</text>
  </van-cell>
</van-cell-group>
</block>
<!-- 其他结款 -->
<view class="uploadImg mb_20" wx:if="{{info.fileList.length>0}}">
  <view class="list clearfix">
    <view class="item" wx:for="{{info.fileList}}">
      <fileviewer url="{{item.fileUrl}}"></fileviewer>
    </view>
  </view>
</view>

<!-- 审核信息 -->
<view class="titleTab fw">审核信息</view>
<view class="stepView">
  <view wx:for="{{info.reviewUserList}}" class="item {{item.reviewSts==2?'ispass':''}}">
    <view class="icon">
      <van-icon name="underway-o" wx:if="{{item.reviewSts == 1}}" style="color: #999;"/>
      <van-icon name="passed" wx:if="{{item.reviewSts == 2}}" style="color: green;" />
      <van-icon name="close" wx:if="{{item.reviewSts == 3}}" style="color: red;" />
    </view>
    <view class="staff">审核部门：{{format.formatTo_(item.orgName)}}</view>
    <view class="org">审核人：{{format.formatTo_(item.userName)}} {{format.formatEmpty(item.reviewDate)}}</view>
    <view class="org">审核意见：{{format.formatTo_(item.reviewRemark)}}</view>
  </view>
</view>

<view class="footerBtn btns" wx:if="{{info.showButton && entitys[1011028]}}">
  <button class="default" bindtap="showAlertMethod" data-type="1">评审通过</button>
  <button bindtap="showAlertMethod" data-type="2">评审不通过</button>
</view>
</block>

<!-- 评审不通过原因 -->
<alert isshow="{{showAlert}}" title="提示" class="showAlert" bind:closealert="cancelAlert" aStyle="width:500rpx;">  
  <view class="content">
    <view class="label">请输入评审意见：</view>
    <input type="text" value="{{remark}}" bindinput="inputSetRemark" placeholder=""></input>
  </view>
  <view class="bottom clearfix">
    <button bindtap="cancelAlert">取消</button>
    <button bindtap="sureAlert">确定</button>  
  </view>
</alert>


<!-- 评审完成 -->
<block wx:if="{{showFinish}}">
  <view class="finishPage">
    <van-icon name="checked" />
    <view class="tipText">评审完成，系统会对应提示申请人</view>
    <view class="numTip">合同评审编码：{{info.contractNum}}</view>
    <view class="con">
      <view class="item clearfix">
        <text class="label fl">供应商名称</text>
        <text class="fr">{{info.tenantName}}</text>
      </view>
      <view class="item clearfix">
        <text class="label fl">申请事由</text>
        <text class="fr">{{format.formatTo_(info.remark)}}</text>
      </view>
      <view class="item clearfix">
        <text class="label fl">申请部门</text>
        <text class="fr">{{format.formatTo_(info.orgName)}}</text>
      </view>
      <view class="item clearfix">
        <text class="label fl">申请人</text>
        <text class="fr">{{format.formatTo_(info.createUserName)}}</text>
      </view>
      <view class="item clearfix">
        <text class="label fl">评审截止日期</text>
        <text class="fr">{{format.formatTo_(info.expireDate)}}</text>
      </view>
    </view>
    <view class="finishView">
      <button bindtap="back">完成</button>
    </view>
  </view>
</block>
